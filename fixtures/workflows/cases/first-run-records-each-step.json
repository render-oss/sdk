{
  "description": "On a first attempt every inline step writes its start row, with its input, before it runs, and completes the row with its output. Each step takes the next seq, from 0, with step_key \"<seq>-run\".",
  "attempt": 0,
  "workflow": [
    {
      "method": "run",
      "name": "charge_card",
      "args": [
        100
      ],
      "attempts": [
        {
          "return": "ch_123"
        }
      ]
    },
    {
      "method": "run",
      "name": "send_receipt",
      "args": [
        "ada@example.com"
      ],
      "attempts": [
        {
          "return": "msg_1"
        }
      ]
    }
  ],
  "exchanges": [
    {
      "request": {
        "path": "/step-inline",
        "body": {
          "step_key": {
            "seq": 0
          },
          "task_name": "charge_card",
          "kind": "start",
          "input": {
            "serializer": "json",
            "value": [
              100
            ]
          },
          "started_at": "<any>"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "applied": true
        }
      }
    },
    {
      "request": {
        "path": "/step-inline",
        "body": {
          "step_key": {
            "seq": 0
          },
          "task_name": "charge_card",
          "kind": "complete",
          "output": {
            "serializer": "json",
            "value": [
              "ch_123"
            ]
          },
          "error": null
        }
      },
      "response": {
        "status": 200,
        "body": {
          "applied": true
        }
      }
    },
    {
      "request": {
        "path": "/step-inline",
        "body": {
          "step_key": {
            "seq": 1
          },
          "task_name": "send_receipt",
          "kind": "start",
          "input": {
            "serializer": "json",
            "value": [
              "ada@example.com"
            ]
          },
          "started_at": "<any>"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "applied": true
        }
      }
    },
    {
      "request": {
        "path": "/step-inline",
        "body": {
          "step_key": {
            "seq": 1
          },
          "task_name": "send_receipt",
          "kind": "complete",
          "output": {
            "serializer": "json",
            "value": [
              "msg_1"
            ]
          },
          "error": null
        }
      },
      "response": {
        "status": 200,
        "body": {
          "applied": true
        }
      }
    }
  ],
  "callback": {
    "complete": {
      "output": {
        "serializer": "json",
        "value": [
          {
            "results": [
              "ch_123",
              "msg_1"
            ]
          }
        ]
      },
      "error": null
    }
  }
}
